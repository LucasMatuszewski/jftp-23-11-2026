{
  "include": ["src/**/*.java", "pom.xml"],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": ["docs/repo-maps/**", "docs/repomix/**", ".agents/**", ".claude/**", "**/.env", "**/.env.*", "**/*.key", "**/*.keystore"]
  },
  "output": {"style": "xml", "parsableStyle": true, "compress": true, "removeComments": true, "fileSummary": true, "directoryStructure": true},
  "security": {"enableSecurityCheck": true},
  "tokenCount": {"encoding": "o200k_base"}
}
